{
  "rules": {
    "nextInventory": {
      ".read": true,
      ".write": true,
      "$store": {
        "$month": {
          "values": {
            "$item": {
              ".validate": "!newData.exists() || (newData.hasChildren(['v1','v2','v3']) && newData.child('v1').isString() && newData.child('v2').isString() && newData.child('v3').isString())"
            }
          }
        }
      }
    }
  }
}